+using System.Net;
+using System.Text.Json;
+using FileManager.IntegrationTests.Constants;
+using FileManager.IntegrationTests.Fixtures;
+using FileManager.IntegrationTests.Helpers;
+using FluentAssertions;
+
+namespace FileManager.IntegrationTests
+{
+    /// <summary>
+    /// Creating a product image over HTTP: the image comes back on the list endpoint, a soft-deleted
+    /// image does not, and the create writes its activity row.
+    /// </summary>
+    [Collection(IntegrationTestCollection.Name)]
+    public class ProductImageApiTests
+    {
+        private readonly HttpClient _client;
+        private readonly TestingWebApplicationFactory<Program> _factory;
+
+        public ProductImageApiTests(TestingWebApplicationFactory<Program> factory)
+        {
+            _factory = factory;
+            _client = factory.CreateClient();
+        }
+
+        [Fact]
+        public async Task CreatedImageIsListedAndAudited()
+        {
+            await DealApiFactory.AuthenticateClientAsync(_client);
+            var productId = TestConstants.DealDomain.ProductId;
+
+            var create = await _client.PostAsync(
+                $"/api/v2/products/{productId}/images",
+                DealApiFactory.JsonBody(new { url = "https://cdn.example.com/a.png", altText = "front" }));
+
+            create.StatusCode.Should().Be(HttpStatusCode.OK, "creating an image should succeed");
+
+            var created = await DealApiFactory.ReadRootAsync(create);
+            var imageId = created.GetProperty("data").GetProperty("id").GetGuid();
+
+            var list = await _client.GetAsync($"/api/v2/products/{productId}/images");
+            var listRoot = await DealApiFactory.ReadRootAsync(list);
+            listRoot.GetProperty("data").EnumerateArray()
+                .Select(i => i.GetProperty("id").GetGuid())
+                .Should().Contain(imageId, "a newly created image belongs in the list");
+
+            await AssertActivityWrittenAsync(imageId, "ProductImageCreated");
+
+            var delete = await _client.DeleteAsync($"/api/v2/products/{productId}/images/{imageId}");
+            delete.StatusCode.Should().Be(HttpStatusCode.OK);
+
+            var afterDelete = await _client.GetAsync($"/api/v2/products/{productId}/images");
+            var afterRoot = await DealApiFactory.ReadRootAsync(afterDelete);
+            afterRoot.GetProperty("data").EnumerateArray()
+                .Select(i => i.GetProperty("id").GetGuid())
+                .Should().NotContain(imageId, "a soft-deleted image must not come back from the list");
+        }
+
+        private async Task AssertActivityWrittenAsync(Guid entityId, string activityType)
+        {
+            using var scope = _factory.Services.CreateScope();
+            var context = scope.ServiceProvider.GetRequiredService<RepositoryContext>();
+
+            var activity = await context.SystemActivities
+                .Include(a => a.AdditionalInfos)
+                .FirstOrDefaultAsync(a => a.ActivityType == activityType);
+
+            activity.Should().NotBeNull("every mutation writes an activity row");
+            activity!.AdditionalInfos.Should().Contain(i => i.Key == "EntityId" && i.Value == entityId.ToString());
+        }
+    }
+}
