@@ -0,0 +1,87 @@
+using Ardalis.Result;
+using AutoMapper;
+using Contracts;
+using Entities.Models;
+using Microsoft.Extensions.Configuration;
+using Service.Contracts;
+using Service.Extensions;
+using Shared;
+using Shared.DataTransferObjects;
+
+namespace Service
+{
+    public class PlacardPhotoService : IPlacardPhotoService
+    {
+        private readonly IRepositoryManager _repository;
+        private readonly IMapper _mapper;
+        private readonly ILoggedInUserService _loggedInUserService;
+        private readonly ISystemActivityService _systemActivityService;
+        private readonly string _cdnBaseUrl;
+
+        public PlacardPhotoService(
+            IRepositoryManager repository,
+            IMapper mapper,
+            ILoggedInUserService loggedInUserService,
+            ISystemActivityService systemActivityService,
+            IConfiguration configuration)
+        {
+            _repository = repository;
+            _mapper = mapper;
+            _loggedInUserService = loggedInUserService;
+            _systemActivityService = systemActivityService;
+            _cdnBaseUrl = configuration["PlacardPhotos:CdnBaseUrl"] ?? string.Empty;
+        }
+
+        public async Task<Result<List<PlacardPhotoDto>>> GetPlacardPhotosAsync(Guid placardId)
+        {
+            var images = await _repository.PlacardPhotos.GetPlacardPhotosAsync(placardId, trackChanges: false);
+            return _mapper.Map<List<PlacardPhotoDto>>(images);
+        }
+
+        public async Task<Result<PlacardPhotoDto>> CreatePlacardPhotoAsync(Guid placardId, PlacardPhotoCreateDto createDto)
+        {
+            var product = await _repository.Placards.GetPlacardByIdAsync(placardId, trackChanges: false);
+            if (product is null)
+                return Result.NotFound();
+
+            if (await _repository.PlacardPhotos.UrlExistsAsync(placardId, createDto.Url))
+                return Result.Invalid(new ValidationError(ResponseMessages.productImageDuplicateUrl));
+
+            var image = _mapper.Map<PlacardPhoto>(createDto);
+            image.PlacardId = placardId;
+            image.IsActive = true;
+            image.CreatedBy = _loggedInUserService.UserId;
+
+            _repository.PlacardPhotos.CreatePlacardPhoto(image);
+            await _repository.SaveAsync();
+
+            await _systemActivityService.LogEntityAsync(
+                ActivityTypes.PlacardPhotoCreated,
+                image.Id,
+                ("PlacardId", placardId.ToString()),
+                ("Url", image.Url));
+
+            var created = await _repository.PlacardPhotos.GetPlacardPhotoByIdAsync(image.Id, trackChanges: false);
+            return _mapper.Map<PlacardPhotoDto>(created);
+        }
+
+        public async Task<Result> DeletePlacardPhotoAsync(Guid placardId, Guid imageId)
+        {
+            var image = await _repository.PlacardPhotos.GetPlacardPhotoByIdAsync(imageId, trackChanges: true);
+            if (image is null || image.PlacardId != placardId)
+                return Result.NotFound();
+
+            image.IsDeleted = true;
+            image.UpdatedBy = _loggedInUserService.UserId;
+            await _repository.SaveAsync();
+
+            await _systemActivityService.LogEntityAsync(
+                ActivityTypes.PlacardPhotoDeleted,
+                image.Id,
+                ("PlacardId", placardId.ToString()),
+                ("OldUrl", image.Url));
+
+            return Result.Success();
+        }
+    }
+}
