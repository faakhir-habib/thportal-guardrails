@@ -0,0 +1,87 @@
+using Ardalis.Result;
+using AutoMapper;
+using Contracts;
+using Entities.Models;
+using Microsoft.Extensions.Configuration;
+using Service.Contracts;
+using Service.Extensions;
+using Shared;
+using Shared.DataTransferObjects;
+
+namespace Service
+{
+    public class ProductImageService : IProductImageService
+    {
+        private readonly IRepositoryManager _repository;
+        private readonly IMapper _mapper;
+        private readonly ILoggedInUserService _loggedInUserService;
+        private readonly ISystemActivityService _systemActivityService;
+        private readonly string _cdnBaseUrl;
+
+        public ProductImageService(
+            IRepositoryManager repository,
+            IMapper mapper,
+            ILoggedInUserService loggedInUserService,
+            ISystemActivityService systemActivityService,
+            IConfiguration configuration)
+        {
+            _repository = repository;
+            _mapper = mapper;
+            _loggedInUserService = loggedInUserService;
+            _systemActivityService = systemActivityService;
+            _cdnBaseUrl = configuration["ProductImages:CdnBaseUrl"] ?? string.Empty;
+        }
+
+        public async Task<Result<List<ProductImageDto>>> GetProductImagesAsync(Guid productId)
+        {
+            var images = await _repository.ProductImages.GetProductImagesAsync(productId, trackChanges: false);
+            return _mapper.Map<List<ProductImageDto>>(images);
+        }
+
+        public async Task<Result<ProductImageDto>> CreateProductImageAsync(Guid productId, ProductImageCreateDto createDto)
+        {
+            var product = await _repository.Products.GetProductByIdAsync(productId, trackChanges: false);
+            if (product is null)
+                return Result.NotFound();
+
+            if (await _repository.ProductImages.UrlExistsAsync(productId, createDto.Url))
+                return Result.Invalid(new ValidationError(ResponseMessages.productImageDuplicateUrl));
+
+            var image = _mapper.Map<ProductImage>(createDto);
+            image.ProductId = productId;
+            image.IsActive = true;
+            image.CreatedBy = _loggedInUserService.UserId;
+
+            _repository.ProductImages.CreateProductImage(image);
+            await _repository.SaveAsync();
+
+            await _systemActivityService.LogEntityAsync(
+                ActivityTypes.ProductImageCreated,
+                image.Id,
+                ("ProductId", productId.ToString()),
+                ("Url", image.Url));
+
+            var created = await _repository.ProductImages.GetProductImageByIdAsync(image.Id, trackChanges: false);
+            return _mapper.Map<ProductImageDto>(created);
+        }
+
+        public async Task<Result> DeleteProductImageAsync(Guid productId, Guid imageId)
+        {
+            var image = await _repository.ProductImages.GetProductImageByIdAsync(imageId, trackChanges: true);
+            if (image is null || image.ProductId != productId)
+                return Result.NotFound();
+
+            image.IsDeleted = true;
+            image.UpdatedBy = _loggedInUserService.UserId;
+            await _repository.SaveAsync();
+
+            await _systemActivityService.LogEntityAsync(
+                ActivityTypes.ProductImageDeleted,
+                image.Id,
+                ("ProductId", productId.ToString()),
+                ("OldUrl", image.Url));
+
+            return Result.Success();
+        }
+    }
+}
