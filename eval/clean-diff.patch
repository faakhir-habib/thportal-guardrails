+using Contracts;
+using Entities.Models;
+using Microsoft.EntityFrameworkCore;
+
+namespace Repository
+{
+    public class PlacardPhotoRepository : RepositoryBase<PlacardPhoto>, IPlacardPhotoRepository
+    {
+        public PlacardPhotoRepository(RepositoryContext repositoryContext) : base(repositoryContext)
+        {
+        }
+
+        public async Task<PlacardPhoto?> GetPlacardPhotoByIdAsync(Guid id, bool trackChanges) =>
+            await FindByCondition(p => p.Id == id && p.IsDeleted == false, trackChanges)
+                .FirstOrDefaultAsync();
+
+        public async Task<List<PlacardPhoto>> GetPlacardPhotosAsync(Guid placardId, bool trackChanges) =>
+            await FindByCondition(p => p.PlacardId == placardId && p.IsActive && p.IsDeleted == false, trackChanges)
+                .OrderBy(p => p.CreatedAt)
+                .ToListAsync();
+
+        public async Task<List<PlacardPhoto>> GetAllIncludingInactiveAsync(Guid placardId, bool trackChanges) =>
+            await FindByCondition(p => p.PlacardId == placardId && p.IsDeleted == false, trackChanges)
+                .ToListAsync();
+
+        public async Task<bool> UrlExistsAsync(Guid placardId, string url) =>
+            await FindByCondition(p => p.PlacardId == placardId && p.Url == url && p.IsDeleted == false, trackChanges: false)
+                .AnyAsync();
+
+        public void CreatePlacardPhoto(PlacardPhoto productImage) => Create(productImage);
+
+        public void DeletePlacardPhoto(PlacardPhoto productImage) => Delete(productImage);
+    }
+}
