+using FileManager.Presentation.ActionFilters;
+using Microsoft.AspNetCore.Mvc;
+using Service.Contracts;
+using Shared;
+using Shared.DataTransferObjects;
+
+namespace FileManager.Presentation.Controllers.V2
+{
+    [Route("api/v2/products/{productId:guid}/images")]
+    [ApiController]
+    [ModuleRoleAuthorize(modules: new[] { Modules.Catalog }, roles: new[] { Roles.Admin, Roles.CatalogManager })]
+    public class ProductImageController : ControllerBase
+    {
+        private readonly IServiceManager _service;
+
+        public ProductImageController(IServiceManager service) => _service = service;
+
+        [HttpGet]
+        public async Task<IActionResult> GetProductImages(Guid productId)
+        {
+            var result = await _service.ProductImageService.GetProductImagesAsync(productId);
+            return result.ToActionResult(ResponseMessages.productImagesFetched);
+        }
+
+        [HttpPost]
+        [ServiceFilter(typeof(ValidationFilterAttribute))]
+        public async Task<IActionResult> CreateProductImage(Guid productId, [FromBody] ProductImageCreateDto createDto)
+        {
+            var result = await _service.ProductImageService.CreateProductImageAsync(productId, createDto);
+            return result.ToActionResult(ResponseMessages.productImageInserted);
+        }
+
+        [HttpDelete("{imageId:guid}")]
+        public async Task<IActionResult> DeleteProductImage(Guid productId, Guid imageId)
+        {
+            var result = await _service.ProductImageService.DeleteProductImageAsync(productId, imageId);
+            return result.ToActionResult(ResponseMessages.productImageDeleted);
+        }
+    }
+}
