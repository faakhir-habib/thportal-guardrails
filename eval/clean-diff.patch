+using Contracts;
+using Entities.Models;
+using Microsoft.EntityFrameworkCore;
+
+namespace Repository
+{
+    public class ProductImageRepository : RepositoryBase<ProductImage>, IProductImageRepository
+    {
+        public ProductImageRepository(RepositoryContext repositoryContext) : base(repositoryContext)
+        {
+        }
+
+        public async Task<ProductImage?> GetProductImageByIdAsync(Guid id, bool trackChanges) =>
+            await FindByCondition(p => p.Id == id && p.IsDeleted == false, trackChanges)
+                .FirstOrDefaultAsync();
+
+        public async Task<List<ProductImage>> GetProductImagesAsync(Guid productId, bool trackChanges) =>
+            await FindByCondition(p => p.ProductId == productId && p.IsActive && p.IsDeleted == false, trackChanges)
+                .OrderBy(p => p.CreatedAt)
+                .ToListAsync();
+
+        public async Task<List<ProductImage>> GetAllIncludingInactiveAsync(Guid productId, bool trackChanges) =>
+            await FindByCondition(p => p.ProductId == productId && p.IsDeleted == false, trackChanges)
+                .ToListAsync();
+
+        public async Task<bool> UrlExistsAsync(Guid productId, string url) =>
+            await FindByCondition(p => p.ProductId == productId && p.Url == url && p.IsDeleted == false, trackChanges: false)
+                .AnyAsync();
+
+        public void CreateProductImage(ProductImage productImage) => Create(productImage);
+
+        public void DeleteProductImage(ProductImage productImage) => Delete(productImage);
+    }
+}
