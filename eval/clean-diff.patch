+using FileManager.Presentation.ActionFilters;
+using Microsoft.AspNetCore.Mvc;
+using Service.Contracts;
+using Shared;
+using Shared.DataTransferObjects;
+
+namespace FileManager.Presentation.Controllers.V2
+{
+    [Route("api/v2/products/{placardId:guid}/images")]
+    [ApiController]
+    [ModuleRoleAuthorize(modules: new[] { Modules.Catalog }, roles: new[] { Roles.Admin, Roles.CatalogManager })]
+    public class PlacardPhotoController : ControllerBase
+    {
+        private readonly IServiceManager _service;
+
+        public PlacardPhotoController(IServiceManager service) => _service = service;
+
+        [HttpGet]
+        public async Task<IActionResult> GetPlacardPhotos(Guid placardId)
+        {
+            var result = await _service.PlacardPhotoService.GetPlacardPhotosAsync(placardId);
+            return result.ToActionResult(ResponseMessages.productImagesFetched);
+        }
+
+        [HttpPost]
+        [ServiceFilter(typeof(ValidationFilterAttribute))]
+        public async Task<IActionResult> CreatePlacardPhoto(Guid placardId, [FromBody] PlacardPhotoCreateDto createDto)
+        {
+            var result = await _service.PlacardPhotoService.CreatePlacardPhotoAsync(placardId, createDto);
+            return result.ToActionResult(ResponseMessages.productImageInserted);
+        }
+
+        [HttpDelete("{imageId:guid}")]
+        public async Task<IActionResult> DeletePlacardPhoto(Guid placardId, Guid imageId)
+        {
+            var result = await _service.PlacardPhotoService.DeletePlacardPhotoAsync(placardId, imageId);
+            return result.ToActionResult(ResponseMessages.productImageDeleted);
+        }
+    }
+}
