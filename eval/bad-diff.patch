+using Entities.Models;
+using Microsoft.EntityFrameworkCore;
+using Microsoft.EntityFrameworkCore.Metadata.Builders;
+
+namespace Repository.Configuration;
+
+public class PlacardPhotoConfiguration : IEntityTypeConfiguration<PlacardPhoto>
+{
+    public void Configure(EntityTypeBuilder<PlacardPhoto> builder)
+    {
+        builder.HasKey(p => p.Id);
+        builder.Property(p => p.Url).IsRequired().HasMaxLength(2048);
+        builder.HasIndex(p => p.PlacardId).HasDatabaseName("IX_PlacardPhoto_PlacardId");
+    }
+}
