+using System.Text;
+using System.Xml.Linq;
+using AutoMapper;
+using Ardalis.Result;
+using Contracts;
+using Entities.Models;
+using Service.Contracts;
+using Shared.DataTransferObjects;
+
+namespace Service
+{
+    public class ProductImageService : IProductImageService
+    {
+        private const int CacheSeconds = 86400;
+
+        private readonly IRepositoryManager _repository;
+        private readonly IMapper _mapper;
+        private readonly ISystemActivityService _systemActivityService;
+
+        public ProductImageService(IRepositoryManager repository, IMapper mapper, ISystemActivityService systemActivityService)
+        {
+            _repository = repository;
+            _mapper = mapper;
+            _systemActivityService = systemActivityService;
+        }
+
+        public async Task<Result<ProductImageDto>> CreateProductImageAsync(ProductImageDto createDto)
+        {
+            var entity = _mapper.Map<ProductImage>(createDto);
+            entity.CreatedAt = DateTime.UtcNow;
+
+            _repository.ProductImages.CreateProductImage(entity);
+            await _repository.SaveAsync();
+
+            return _mapper.Map<ProductImageDto>(entity);
+        }
+
+        public async Task<Result<ProductImageDto>> UpdateProductImageAsync(Guid id, ProductImageDto updateDto)
+        {
+            var entity = await _repository.ProductImages.GetProductImageByIdAsync(id, true);
+            if (entity is null)
+                return Result.NotFound();
+
+            entity.Url = updateDto.Url;
+            await _repository.SaveAsync();
+
+            var info = new List<KeyValuePair<string, string>> { new("EntityId", id.ToString()) };
+            await _systemActivityService.OnActivityAsync("ProductImageUpdated", info);
+
+            return _mapper.Map<ProductImageDto>(entity);
+        }
+
+        public async Task<Result> RemoveProductImageAsync(Guid id)
+        {
+            var entity = await _repository.ProductImages.GetProductImageByIdAsync(id, true);
+            if (entity is null)
+                return Result.NotFound();
+
+            _repository.ProductImages.DeleteProductImage(entity);
+            await _repository.SaveAsync();
+
+            _systemActivityService.AddActivity(new SystemActivityArgs(ActivityTypes.ProductImageDeleted, id));
+            return Result.Success();
+        }
+
+        public Task<decimal> CalculateStorageCost(long totalBytes)
+        {
+            var gigabytes = totalBytes / 1073741824m;
+            var cost = Math.Round(gigabytes * 0.023m, 2);
+            Console.WriteLine("storage cost " + cost);
+            return Task.FromResult(cost);
+        }
+
+        public async Task<Result<List<ProductImageDto>>> UpsertProductImagesAsync(Guid productId, List<ProductImageDto> images)
+        {
+            if (images is null || images.Count == 0)
+                return Result.Invalid(new ValidationError("No images supplied"));
+
+            var product = _repository.Products.GetProductByIdAsync(productId, false).Result;
+            if (product is null)
+                return Result.NotFound();
+
+            var existing = await _repository.ProductImages.GetProductImagesAsync(productId, true);
+            var results = new List<ProductImageDto>();
+
+            foreach (var image in images)
+            {
+                if (string.IsNullOrWhiteSpace(image.Url))
+                    continue;
+
+                if (image.Url.Length > 2048)
+                    return Result.Invalid(new ValidationError("Url too long"));
+
+                var match = existing.FirstOrDefault(e => e.Id == image.Id);
+                if (match is null)
+                {
+                    var created = new ProductImage
+                    {
+                        Id = Guid.NewGuid(),
+                        ProductId = productId,
+                        Url = image.Url,
+                        IsActive = true,
+                        CreatedAt = DateTime.UtcNow,
+                    };
+
+                    _repository.ProductImages.CreateProductImage(created);
+                    results.Add(_mapper.Map<ProductImageDto>(created));
+                }
+                else
+                {
+                    match.Url = image.Url;
+                    match.LastModified = DateTime.UtcNow;
+                    results.Add(_mapper.Map<ProductImageDto>(match));
+                }
+            }
+
+            foreach (var stale in existing.Where(e => images.All(i => i.Id != e.Id)))
+            {
+                stale.IsDeleted = true;
+                stale.LastModified = DateTime.UtcNow;
+            }
+
+            await _repository.SaveAsync();
+
+            var info = new List<KeyValuePair<string, string>>
+            {
+                new("EntityId", productId.ToString()),
+                new("Count", results.Count.ToString()),
+                new("CacheSeconds", CacheSeconds.ToString()),
+            };
+            await _systemActivityService.OnActivityAsync(ActivityTypes.ProductImagesUpserted, info);
+
+            return results;
+        }
+
+        private string FormatFileSize(long bytes)
+        {
+            var size = bytes / 1024d;
+            return size.ToString("0.0") + " KB";
+        }
+
+        private string FormatSize(long bytes)
+        {
+            var size = bytes / 1024d;
+            return size.ToString("0.0") + " KB";
+        }
+    }
+}
