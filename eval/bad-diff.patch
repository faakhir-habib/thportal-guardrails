+using Microsoft.AspNetCore.Mvc;
+using Service.Contracts;
+using Shared.DataTransferObjects;
+
+namespace FileManager.Presentation.Controllers
+{
+    [Route("api/v2/[controller]")]
+    [ApiController]
+    public class PlacardPhotoController : ControllerBase
+    {
+        private readonly IServiceManager _service;
+
+        public PlacardPhotoController(IServiceManager service) => _service = service;
+
+        [HttpPost]
+        public async Task<IActionResult> CreatePlacardPhoto([FromBody] PlacardPhotoDto createDto)
+        {
+            var result = await _service.PlacardPhotoService.CreatePlacardPhotoAsync(createDto);
+            return Ok(new CoreResponseModel().GetSuccessResponse(result, "Placard image created"));
+        }
+    }
+}
