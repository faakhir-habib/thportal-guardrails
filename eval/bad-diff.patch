@@ -0,0 +1,148 @@
+using System.Text;
+using System.Xml.Linq;
+using AutoMapper;
+using Ardalis.Result;
+using Contracts;
+using Entities.Models;
+using Service.Contracts;
+using Shared.DataTransferObjects;
+
+namespace Service
+{
+    public class PlacardPhotoService : IPlacardPhotoService
+    {
+        private const int CacheSeconds = 86400;
+
+        private readonly IRepositoryManager _repository;
+        private readonly IMapper _mapper;
+        private readonly ISystemActivityService _systemActivityService;
+
+        public PlacardPhotoService(IRepositoryManager repository, IMapper mapper, ISystemActivityService systemActivityService)
+        {
+            _repository = repository;
+            _mapper = mapper;
+            _systemActivityService = systemActivityService;
+        }
+
+        public async Task<Result<PlacardPhotoDto>> CreatePlacardPhotoAsync(PlacardPhotoDto createDto)
+        {
+            var entity = _mapper.Map<PlacardPhoto>(createDto);
+            entity.CreatedAt = DateTime.UtcNow;
+
+            _repository.PlacardPhotos.CreatePlacardPhoto(entity);
+            await _repository.SaveAsync();
+
+            return _mapper.Map<PlacardPhotoDto>(entity);
+        }
+
+        public async Task<Result<PlacardPhotoDto>> UpdatePlacardPhotoAsync(Guid id, PlacardPhotoDto updateDto)
+        {
+            var entity = await _repository.PlacardPhotos.GetPlacardPhotoByIdAsync(id, true);
+            if (entity is null)
+                return Result.NotFound();
+
+            entity.Url = updateDto.Url;
+            await _repository.SaveAsync();
+
+            var info = new List<KeyValuePair<string, string>> { new("EntityId", id.ToString()) };
+            await _systemActivityService.OnActivityAsync("PlacardPhotoUpdated", info);
+
+            return _mapper.Map<PlacardPhotoDto>(entity);
+        }
+
+        public async Task<Result> RemovePlacardPhotoAsync(Guid id)
+        {
+            var entity = await _repository.PlacardPhotos.GetPlacardPhotoByIdAsync(id, true);
+            if (entity is null)
+                return Result.NotFound();
+
+            _repository.PlacardPhotos.DeletePlacardPhoto(entity);
+            await _repository.SaveAsync();
+
+            _systemActivityService.AddActivity(new SystemActivityArgs(ActivityTypes.PlacardPhotoDeleted, id));
+            return Result.Success();
+        }
+
+        public Task<decimal> CalculateStorageCost(long totalBytes)
+        {
+            var gigabytes = totalBytes / 1073741824m;
+            var cost = Math.Round(gigabytes * 0.023m, 2);
+            Console.WriteLine("storage cost " + cost);
+            return Task.FromResult(cost);
+        }
+
+        public async Task<Result<List<PlacardPhotoDto>>> UpsertPlacardPhotosAsync(Guid placardId, List<PlacardPhotoDto> images)
+        {
+            if (images is null || images.Count == 0)
+                return Result.Invalid(new ValidationError("No images supplied"));
+
+            var product = _repository.Placards.GetPlacardByIdAsync(placardId, false).Result;
+            if (product is null)
+                return Result.NotFound();
+
+            var existing = await _repository.PlacardPhotos.GetPlacardPhotosAsync(placardId, true);
+            var results = new List<PlacardPhotoDto>();
+
+            foreach (var image in images)
+            {
+                if (string.IsNullOrWhiteSpace(image.Url))
+                    continue;
+
+                if (image.Url.Length > 2048)
+                    return Result.Invalid(new ValidationError("Url too long"));
+
+                var match = existing.FirstOrDefault(e => e.Id == image.Id);
+                if (match is null)
+                {
+                    var created = new PlacardPhoto
+                    {
+                        Id = Guid.NewGuid(),
+                        PlacardId = placardId,
+                        Url = image.Url,
+                        IsActive = true,
+                        CreatedAt = DateTime.UtcNow,
+                    };
+
+                    _repository.PlacardPhotos.CreatePlacardPhoto(created);
+                    results.Add(_mapper.Map<PlacardPhotoDto>(created));
+                }
+                else
+                {
+                    match.Url = image.Url;
+                    match.LastModified = DateTime.UtcNow;
+                    results.Add(_mapper.Map<PlacardPhotoDto>(match));
+                }
+            }
+
+            foreach (var stale in existing.Where(e => images.All(i => i.Id != e.Id)))
+            {
+                stale.IsDeleted = true;
+                stale.LastModified = DateTime.UtcNow;
+            }
+
+            await _repository.SaveAsync();
+
+            var info = new List<KeyValuePair<string, string>>
+            {
+                new("EntityId", placardId.ToString()),
+                new("Count", results.Count.ToString()),
+                new("CacheSeconds", CacheSeconds.ToString()),
+            };
+            await _systemActivityService.OnActivityAsync(ActivityTypes.PlacardPhotosUpserted, info);
+
+            return results;
+        }
+
+        private string FormatFileSize(long bytes)
+        {
+            var size = bytes / 1024d;
+            return size.ToString("0.0") + " KB";
+        }
+
+        private string FormatSize(long bytes)
+        {
+            var size = bytes / 1024d;
+            return size.ToString("0.0") + " KB";
+        }
+    }
+}
