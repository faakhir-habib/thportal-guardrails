{
  "attribution": { "commit": "", "pr": "" },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [{ "type": "command", "command": "node .claude/guardrails/scripts/hooks/pre-tool-use.mjs" }]
      },
      {
        "matcher": "Write|Edit",
        "hooks": [{ "type": "command", "command": "node .claude/guardrails/scripts/hooks/pre-tool-use.mjs" }]
      }
    ],
    "SessionStart": [
      {
        "hooks": [{ "type": "command", "command": "node .claude/guardrails/scripts/hooks/session-start.mjs" }]
      }
    ]
  }
}
